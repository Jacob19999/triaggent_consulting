# Copy to .env.local (never commit). Mirror in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only
GEMINI_API_KEY=                           # server only; without it the briefing runs offline
# FOODBRIDGE_AI_MODEL=gemini-flash-latest
# NEXT_PUBLIC_FOODBRIDGE_MODE=demo           # hide the live workspace
# FOODBRIDGE_AI_REQUIRE_AUTH=true            # restrict the agent to signed-in users
# FOODBRIDGE_EMAIL_ONLY_LOGIN=true           # temporary prototype; immediate sign-in, new accounts get manager access
